# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=https://claude.ai,http://localhost:*,http://127.0.0.1:*

# Optional: Live Data Access
ENABLE_LIVE_DATA_ACCESS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=

# Optional: Reformatters Repository
REFORMATTERS_REPO_URL=https://github.com/dynamical/reformatters.git
